# YAZIO account
Yazio__Username=you@example.com
Yazio__Password=

# Key for the MCP endpoint (Authorization: Bearer <key> or ?key=<key>) and password on the OAuth consent page.
# Generate: openssl rand -hex 32
Mcp__ApiKey=

# Public base URL for OAuth metadata, e.g. https://yazio.example.com (optional)
Mcp__PublicUrl=

# Time zone used for "today" / "now"
TZ=Asia/Dubai
